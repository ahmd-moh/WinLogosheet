    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <!-- Declares per-monitor DPI awareness. Without it a scaled display (125%,
         150%) hands the node logical coordinates, and the capture comes back as
         the top-left corner of the screen instead of the whole wall view. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
